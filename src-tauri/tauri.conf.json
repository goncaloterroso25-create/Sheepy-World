{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sheepy World - A Cheeky Tale",
  "version": "0.1.0",
  "identifier": "com.goncaloterroso.sheepyworld",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sheepy World: A Cheeky Tale",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 360,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Game",
    "shortDescription": "A cheeky tale of memories, cats, and finding your way home.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Sheepy World"
      }
    }
  }
}
